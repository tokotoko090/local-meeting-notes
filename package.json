{
  "name": "local-meeting-notes",
  "version": "0.3.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start:browser": "node scripts/start-browser.cjs",
    "build": "vite build && tsc --noEmit",
